# =====================================================================
# PROPERTY BOARD GAME COMPANION - PRODUCTION SERVER ENV TEMPLATE
# =====================================================================
PORT=5000
NODE_ENV=production

# Comma-separated allowed frontend URLs (Vercel URL + optional localhost)
CLIENT_URL=https://your-app.vercel.app,http://localhost:3000

# Use 'true' for zero-DB in-memory mode, or 'false' with MONGODB_URI set
USE_MEMORY_STORE=true
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/property_game
